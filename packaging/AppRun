#!/bin/sh
set -eu
HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
export LD_LIBRARY_PATH="$HERE/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="$HERE/usr/plugins"
export QT_QPA_PLATFORM_PLUGIN_PATH="$HERE/usr/plugins/platforms"
# This package uses xcb on X11, or XWayland on a Wayland desktop.
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-xcb}"
export ALSA_PLUGIN_DIR="$HERE/usr/lib/alsa-lib"
export ALSA_CONFIG_DIR="$HERE/usr/share/alsa"
export ALSA_CONFIG_PATH="$HERE/usr/share/alsa/alsa.conf"
exec "$HERE/usr/bin/tk-app" "$@"
